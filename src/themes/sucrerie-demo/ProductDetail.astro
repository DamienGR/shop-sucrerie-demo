---
import type { ProductDetailModel, ProductPurchaseModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import ProductGallery from '../../features/storefront/controls/ProductGallery.astro';
import ProductPurchaseForm from '../../features/storefront/controls/ProductPurchaseForm.astro';
import { t } from '../../features/i18n';
import { candyForName } from './candy';

/**
 * Sucrerie Démo : la fiche produit.
 *
 * Toute la page prend la couleur du bonbon : le fond, le galet de la photo, la
 * pastille du prix, le bouton. La couleur est posée sur :root par une feuille
 * de style en ligne, parce que c'est le fond du <body> (et l'en-tête, et le
 * tiroir du panier) qu'il faut repeindre, et que ces éléments sont au-dessus de
 * ce gabarit. Les valeurs viennent de la table du thème, jamais de la requête.
 *
 * <ProductGallery> et <ProductPurchaseForm> sont gardés tels quels : la
 * galerie porte les ancres et le traitement LCP, le formulaire porte les noms
 * de champs, les états épuisés et `data-fullpage`. tokens.css ne fait que les
 * remettre en forme (galet, pastilles de poids, bouton qui s'écrase).
 */
interface Props {
  model: ProductDetailModel;
  purchase: ProductPurchaseModel;
}

const { model, purchase } = Astro.props;
const candy = candyForName(model.name);
const paint = `:root{--color-paper:${candy.pale};--candy:${candy.vivid};--candy-pale:${candy.pale};--candy-deep:${candy.deep};--candy-ink:${candy.ink}}`;
---

<style is:inline set:html={paint}></style>

<nav aria-label="Fil d’Ariane" class="mb-8 flex flex-wrap items-center gap-2 text-[0.875rem] font-semibold">
  <a href={model.backHref} class="sd-crumb">{t('shell.nav.store')}</a>
  {
    model.categories.map((category) => (
      <a href={category.href} class="sd-crumb">
        {category.text}
      </a>
    ))
  }
</nav>

{
  model.error && (
    <p role="alert" class="mb-8 rounded-[1.25rem] bg-surface px-5 py-4 text-[0.9375rem] font-semibold text-ink ring-2 ring-[var(--candy)]">
      {model.error}
    </p>
  )
}

<div class="grid gap-10 lg:grid-cols-12 lg:gap-14 xl:gap-20">
  <div class="lg:col-span-7">
    <ProductGallery images={model.images} hero={model.heroImage} soldOut={model.soldOut} class="sd-gallery" />
  </div>

  <div class="lg:col-span-5">
    <div class="lg:sticky lg:top-32">
      <h1 class="sd-display text-[clamp(2.75rem,5.4vw,4.75rem)]">{model.name}</h1>
      {model.digitalDelivery && <p class="mt-3 text-[0.9375rem] font-semibold">{t('product.digitalDelivery')}</p>}

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <p class="sd-price" data-price-display data-base={model.priceCents} data-currency={model.currency}>
          {model.priceVaries && <span class="mr-1 text-[0.9375rem]">{t('product.priceFrom')}</span>}
          {model.formattedPrice}
        </p>
        <p class="text-[0.875rem] font-semibold text-muted">TVA incluse</p>
      </div>

      {
        model.lowStock && (
          <p data-low-stock class="mt-5 inline-flex items-center gap-2 rounded-full bg-surface px-4 py-2 text-[0.875rem] font-bold">
            <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--candy)]" />
            Plus que quelques pièces, c’est fait main.
          </p>
        )
      }

      <div class="sd-purchase">
        <ProductPurchaseForm model={purchase} />
      </div>

      <ul class="mt-8 grid gap-3 text-[0.9375rem] font-semibold sm:grid-cols-2">
        <li class="sd-promise">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" /></svg>
          Expédié sous 48 h, offert dès 45 €
        </li>
        <li class="sd-promise">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z" /></svg>
          Fait main dans notre atelier lyonnais
        </li>
      </ul>

      {
        model.descriptionHtml && (
          <details open class="sd-details mt-8">
            <summary>
              {t('product.details')}
              <span aria-hidden="true" class="sd-details-mark" />
            </summary>
            <div class="markdown-content sd-product-copy" set:html={model.descriptionHtml} />
          </details>
        )
      }

      <details class="sd-details mt-3">
        <summary>
          Livraison
          <span aria-hidden="true" class="sd-details-mark" />
        </summary>
        <div class="sd-product-copy space-y-3">
          <p>
            Colissimo suivi en 48 h : 4,90 €. Point relais en 3 à 5 jours : 3,50 €. Livraison offerte dès 45 € d’achat, en
            France métropolitaine.
          </p>
          <p>
            Nos bonbons voyagent dans une boîte calée de papier de soie. Pendant les fortes chaleurs, les caramels et le nougat
            partent le lundi, pour ne pas passer le week-end en entrepôt.
          </p>
          <a href="/pages/livraison" class="sd-link font-bold">Toutes les conditions</a>
        </div>
      </details>

      <button
        type="button"
        data-share
        data-share-title={model.name}
        class="mt-6 hidden w-fit items-center gap-2 rounded-full px-1 text-[0.875rem] font-bold transition-colors hover:text-[var(--candy-deep)]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3" />
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="19" r="3" />
          <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
          <line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
        </svg>
        <span data-share-label>{t('product.share')}</span>
      </button>
    </div>
  </div>
</div>

{
  model.related.length > 0 && (
    <section class="mt-24 sm:mt-32" aria-labelledby="sd-related">
      <h2 id="sd-related" class="sd-title mb-10 text-[clamp(2rem,4vw,3.25rem)]">
        {t('product.related')}
      </h2>
      <ul class="sd-grid sd-grid-4">
        {model.related.map((card, i) => (
          <ProductCard card={card} index={i + 1} headingLevel="h3" />
        ))}
      </ul>
    </section>
  )
}
