---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';
import { t } from '../../features/i18n';

/**
 * Sucrerie Démo : l'en-tête.
 *
 * Une pilule blanche qui flotte au-dessus de la page, collante, sur une barre
 * transparente : la couleur de la page (le citron de l'accueil, la teinte du
 * bonbon sur une fiche) passe tout autour. La marque à gauche, avec sa sucette,
 * les rayons au milieu, la recherche et le panier à droite.
 *
 * Rendu sur TOUTES les pages, panier, commande, paiement et connexion admin
 * comprises : les contrôles du cœur restent tels quels, seuls leur place et
 * leur style changent.
 *
 * Sous `lg`, le menu marchand passe dans le <details> de <StoreNav>, dont le
 * panneau s'ouvre sous la pilule (voir tokens.css).
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
const control = 'rounded-full text-[0.9375rem] font-bold text-ink transition-colors hover:text-[var(--sd-hover)]';
---

{
  model.announcement && (
    <div class="sd-announce">
      <p class="mx-auto max-w-[var(--page-max)] px-[var(--page-pad-x)] py-2.5 text-center text-[0.875rem] font-bold">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="underline-offset-4 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </p>
    </div>
  )
}

<header class="sd-header sticky top-0 z-30">
  <div class="mx-auto max-w-[var(--page-max)] px-[calc(var(--page-pad-x)-0.25rem)] pt-3">
    <div class="sd-header-pill relative flex h-16 items-center gap-2 pl-3 pr-2 sm:gap-5 sm:pl-5 sm:pr-4 lg:h-[4.5rem]">
      <a href="/" aria-label={model.storeName} class="flex shrink-0 items-center gap-2 rounded-full sm:gap-2.5">
        {
          model.logo ? (
            <img src={model.logo.src} alt={model.logo.alt} class="h-9 max-w-48 object-contain" />
          ) : (
            <>
              <svg class="sd-logo-mark h-8 w-8 shrink-0 sm:h-10 sm:w-10" viewBox="0 0 40 40" aria-hidden="true">
                <circle cx="20" cy="20" r="19" fill="#ff3d7f" />
                <path d="M20 20.5c0-1.6 1.6-2.4 2.9-1.5 2 1.4 1.3 4.8-1.1 5.7-3.4 1.3-6.8-1.6-6.3-5.1.6-4.6 6-6.8 9.7-4.3 4.6 3.1 4 10.1-.9 12.6-5.6 2.9-12.6-.5-13.6-6.6" fill="none" stroke="#ffd23f" stroke-width="3" stroke-linecap="round" />
              </svg>
              <span class="sd-wordmark whitespace-nowrap text-[1.1rem] min-[400px]:text-[1.3rem] sm:text-[1.6rem]">{model.storeName}</span>
            </>
          )
        }
      </a>

      {
        model.headerLinks.length > 0 && (
          <nav aria-label={t('shell.nav.primary')} class="flex min-w-0 items-center max-lg:order-last lg:flex-1 lg:justify-center">
            <StoreNav
              links={model.headerLinks}
              class={`hidden min-w-0 items-center gap-1 lg:flex ${control}`}
              disclosureClass="static text-ink lg:hidden"
            />
          </nav>
        )
      }

      <div class="ml-auto flex shrink-0 items-center gap-0.5 sm:gap-2 lg:ml-0">
        <div class="sd-search hidden items-center gap-2 xl:flex">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" class="shrink-0">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <StoreSearch
            action={model.search.action}
            query={model.search.query}
            inputClass="w-36 bg-transparent text-[0.9375rem] font-semibold text-ink placeholder:text-muted focus:outline-none"
          />
        </div>
        <a href={model.search.action} aria-label={t('shell.search.link')} class="sd-icon-btn inline-flex xl:hidden">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </a>
        {model.account.enabled && <StoreAccountControl href={model.account.href} class={`${control} hidden px-3 py-2 sm:inline-flex`} />}
        {model.cart.enabled && <StoreCartControl href={model.cart.href} class="sd-cart inline-flex items-center whitespace-nowrap" />}
      </div>
    </div>
  </div>
</header>
